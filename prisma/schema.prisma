// AirManager — Prisma schema
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Generic key/value application setting. First minimal model for story 1.1
/// scaffolding; domain models arrive in later stories per the architecture spine.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// System roles. Full permission mapping (AD-5) lands in story 1.3 — here the
/// enum only exists so `User.roles` can be populated at login time.
enum Role {
  ADMIN
  STAFF
  INSTRUCTOR
  PILOT
  STUDENT
}

/// Person registry (AD-11: a single `Person` record per human being; FR-4:
/// one unique anagrafica, no duplicates). Story 1.2 introduced the minimal
/// shape (name + optional email) to attach a display name to an
/// authenticated user; story 2.1 extends it with the full CRUD fields
/// (`phone`/`address`/`fiscalCode`) plus archiving.
model Person {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  email      String?   @unique
  phone      String?
  address    String?
  /// Italian "codice fiscale" — optional (not every person has one on file
  /// yet) but unique when present, same nullable-unique pattern as `email`.
  fiscalCode String?   @unique
  /// Soft-archive timestamp (story 2.1, AC 2): a timestamp rather than a
  /// boolean also records *when* — and there is deliberately no physical
  /// delete API for a `Person` (historical flights/movements must keep
  /// referencing it).
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user              User?
  pilotProfile      PilotProfile?
  studentProfile    StudentProfile?
  instructorProfile InstructorProfile?
}

/// Pilot profile (story 2.2, AC 1/2, AD-11): 1-to-0/1 with `Person`, never a
/// second `Person` row. `deactivatedAt` soft-disables the profile (same
/// rationale as `Person.archivedAt`) instead of deleting the row — future
/// epics (4/5/9) attach rates/flights/training notes to a profile and that
/// history must survive a student→pilot transition or any other
/// deactivation. Reactivating (AC 2) just clears `deactivatedAt` again.
model PilotProfile {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  licenseNumber String
  licenseType   String
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Student ("allievo") profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile`
/// doc for the 1-to-0/1 + soft-deactivation rationale, identical here.
/// `courseStartDate` is a calendar date only (no time-of-day), `@db.Date` so
/// Postgres never stores a time/timezone component for it.
model StudentProfile {
  id              String    @id @default(cuid())
  personId        String    @unique
  person          Person    @relation(fields: [personId], references: [id])
  courseStartDate DateTime  @db.Date
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Instructor profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile` doc for
/// the 1-to-0/1 + soft-deactivation rationale, identical here. `ratings` is a
/// single free-text field for the MVP (e.g. "SEP(land), FI(A)"); structuring
/// it further is deferred to epic 9 if the school domain needs it.
model InstructorProfile {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  ratings       String
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Aircraft fleet registry (story 2.4, AC 1/2; FR-7). `registration` (marche,
/// e.g. "I-ABCD") is the unique human-facing identifier — normalized
/// (`trim().toUpperCase()`) at the Zod boundary so the DB-level uniqueness is
/// case-insensitive in practice. `hourMeterMinutes` is an integer number of
/// minutes (AD-2 — the cardinal constraint of this story): the airframe's
/// total-time contaore is never stored as a float/decimal-hours value: only
/// this module's `src/lib/time.ts` helpers convert it to/from an `H:MM`
/// display string. Operational status (out of service + reason, story 2.5)
/// and rates (`AircraftRate`, epic 4) are deliberately out of scope here —
/// this model is anagrafica only. `archivedAt` follows the same
/// soft-archive pattern as `Person.archivedAt` (story 2.1): a timestamp
/// rather than a boolean, no physical-delete API, since future flights/rates
/// reference the aircraft by id.
model Aircraft {
  id               String    @id @default(cuid())
  registration     String    @unique
  type             String
  model            String
  hourMeterMinutes Int
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Login credentials. 1-to-0/1 with `Person` (AD-11) — not every `Person` has
/// a login (e.g. a pilot who never receives an account), and not every `User`
/// needs a `Person` yet (kept optional to avoid coupling auth to the full
/// anagrafica before story 2.1 exists).
model User {
  id     String @id @default(cuid())
  email  String @unique
  /// Nullable (story 1.4): an invited user has no password until they follow
  /// their invite link and set one via `AuthToken`. `authorize()` rejects
  /// login for a null `passwordHash` (with the same dummy-verify timing
  /// pattern used for "unknown email"/"inactive user" — see story 1.2/1.4).
  passwordHash String?
  isActive     Boolean @default(true)
  /// UI/email language (story 1.4, AD-7). Kept as a plain string rather than
  /// a Prisma enum so it maps 1:1 onto `next-intl`'s `AppLocale` ('it'|'en')
  /// without a translation layer; validated at the Zod boundary.
  locale       String  @default("it")
  roles        Role[]
  personId     String? @unique
  person       Person? @relation(fields: [personId], references: [id])

  authTokens AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, hashed tokens backing the invite and password-reset email
/// flows (story 1.4, AC 1/3). Only the sha256 hash of the token is ever
/// persisted — the raw value exists only in the emailed link and is never
/// logged or stored.
enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  expiresAt DateTime
  /// Set once the token is consumed — monouso (single-use), never deleted so
  /// a reused/replayed link can still be told apart from an unknown one.
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}
