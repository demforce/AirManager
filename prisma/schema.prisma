// AirManager — Prisma schema
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Generic key/value application setting. First minimal model for story 1.1
/// scaffolding; domain models arrive in later stories per the architecture spine.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// System roles. Full permission mapping (AD-5) lands in story 1.3 — here the
/// enum only exists so `User.roles` can be populated at login time.
enum Role {
  ADMIN
  STAFF
  INSTRUCTOR
  PILOT
  STUDENT
}

/// Person registry (AD-11: a single `Person` record per human being; FR-4:
/// one unique anagrafica, no duplicates). Story 1.2 introduced the minimal
/// shape (name + optional email) to attach a display name to an
/// authenticated user; story 2.1 extends it with the full CRUD fields
/// (`phone`/`address`/`fiscalCode`) plus archiving.
model Person {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  email      String?   @unique
  phone      String?
  address    String?
  /// Italian "codice fiscale" — optional (not every person has one on file
  /// yet) but unique when present, same nullable-unique pattern as `email`.
  fiscalCode String?   @unique
  /// Soft-archive timestamp (story 2.1, AC 2): a timestamp rather than a
  /// boolean also records *when* — and there is deliberately no physical
  /// delete API for a `Person` (historical flights/movements must keep
  /// referencing it).
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user              User?
  pilotProfile      PilotProfile?
  studentProfile    StudentProfile?
  instructorProfile InstructorProfile?
  /// Prepaid account (story 3.1, AD-11): 1-to-0/1 with `Person`, never the
  /// profile — a student->pilot transition never touches it.
  account           Account?
}

/// Pilot profile (story 2.2, AC 1/2, AD-11): 1-to-0/1 with `Person`, never a
/// second `Person` row. `deactivatedAt` soft-disables the profile (same
/// rationale as `Person.archivedAt`) instead of deleting the row — future
/// epics (4/5/9) attach rates/flights/training notes to a profile and that
/// history must survive a student→pilot transition or any other
/// deactivation. Reactivating (AC 2) just clears `deactivatedAt` again.
model PilotProfile {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  licenseNumber String
  licenseType   String
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Student ("allievo") profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile`
/// doc for the 1-to-0/1 + soft-deactivation rationale, identical here.
/// `courseStartDate` is a calendar date only (no time-of-day), `@db.Date` so
/// Postgres never stores a time/timezone component for it.
model StudentProfile {
  id              String    @id @default(cuid())
  personId        String    @unique
  person          Person    @relation(fields: [personId], references: [id])
  courseStartDate DateTime  @db.Date
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Instructor profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile` doc for
/// the 1-to-0/1 + soft-deactivation rationale, identical here. `ratings` is a
/// single free-text field for the MVP (e.g. "SEP(land), FI(A)"); structuring
/// it further is deferred to epic 9 if the school domain needs it.
model InstructorProfile {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  ratings       String
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Historicized hourly rates (epic 4, story 4.2, AD-4) — see `InstructorRate` doc.
  rates InstructorRate[]
}

/// Aircraft operational status (story 2.5, AC 1; FR-8). `OUT_OF_SERVICE` is
/// deliberately distinct from `Aircraft.archivedAt` (story 2.4): an
/// out-of-service aircraft is still active fleet, just not bookable — the
/// real booking block is Epic 7, this enum only carries the flag/reason.
enum AircraftStatus {
  OPERATIONAL
  OUT_OF_SERVICE
}

/// Aircraft fleet registry (story 2.4, AC 1/2; FR-7). `registration` (marche,
/// e.g. "I-ABCD") is the unique human-facing identifier — normalized
/// (`trim().toUpperCase()`) at the Zod boundary so the DB-level uniqueness is
/// case-insensitive in practice. `hourMeterMinutes` is an integer number of
/// minutes (AD-2 — the cardinal constraint of this story): the airframe's
/// total-time contaore is never stored as a float/decimal-hours value: only
/// this module's `src/lib/time.ts` helpers convert it to/from an `H:MM`
/// display string. Story 2.5 (AC 2) makes it change ONLY via a tracked
/// `HourMeterAdjustment` — never through this table's generic update path —
/// so the audit trail can't be bypassed. `status`/`statusReason` (story 2.5,
/// AC 1) are the operational flag: `statusReason` is populated only while
/// `OUT_OF_SERVICE` and cleared on return to service. Rates (`AircraftRate`,
/// epic 4) are deliberately out of scope here — this model is anagrafica
/// only. `archivedAt` follows the same soft-archive pattern as
/// `Person.archivedAt` (story 2.1): a timestamp rather than a boolean, no
/// physical-delete API, since future flights/rates reference the aircraft by
/// id.
model Aircraft {
  id               String         @id @default(cuid())
  registration     String         @unique
  type             String
  model            String
  hourMeterMinutes Int
  notes            String?
  status           AircraftStatus @default(OPERATIONAL)
  /// Mandatory while `status == OUT_OF_SERVICE`; reset to `null` on return to
  /// service (enforced in `aircraft.service.ts`, not at the DB level).
  statusReason     String?
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  hourMeterAdjustments HourMeterAdjustment[]
  /// Historicized hourly rates (epic 4, story 4.1, AD-4) — see `AircraftRate` doc.
  rates                AircraftRate[]
}

/// Historicized hourly rate (story 4.1, epic 4; AD-4/AD-2). Append-only
/// (AD-3's spirit): there is deliberately NO update/delete API — a wrong
/// price is corrected by inserting ANOTHER rate with a later `validFrom`,
/// the history is never rewritten. The rate in effect for a given date D is
/// the row with the MAXIMUM `validFrom <= D` (AD-4) — see
/// `rates.service.ts#getEffectiveRate`, the hook epic 5's flight snapshot
/// will call (not implemented here). `priceCentsPerHour` is an integer
/// number of euro cents (AD-2) and always > 0 — enforced at the Zod/service
/// boundary, not a DB constraint, same choice as `Aircraft.hourMeterMinutes`.
/// `validFrom` is calendar-only (`@db.Date`, same convention as
/// `AccountMovement.effectiveDate`) — a rate takes effect on a whole day,
/// never at a specific time. `@@unique([aircraftId, validFrom])` backs AC 2:
/// two rates for the same aircraft on the same day is a 409, not a silent
/// overwrite.
model AircraftRate {
  id                String   @id @default(cuid())
  aircraftId        String
  aircraft          Aircraft @relation(fields: [aircraftId], references: [id])
  priceCentsPerHour Int
  validFrom         DateTime @db.Date
  /// The acting `User.id` (`Actor.userId`, always present) — who recorded
  /// this rate, same rationale as `HourMeterAdjustment.actorUserId`.
  actorUserId       String
  actorUser         User     @relation(fields: [actorUserId], references: [id])
  createdAt         DateTime @default(now())

  @@unique([aircraftId, validFrom])
  @@index([aircraftId])
}

/// Historicized hourly rate for an instructor (story 4.2, epic 4; AD-4/AD-2)
/// — the deliberate twin of `AircraftRate`, same shape and same rules, just
/// keyed on `instructorProfileId` instead of `aircraftId`. Append-only (AD-3's
/// spirit): there is deliberately NO update/delete API — a wrong price is
/// corrected by inserting ANOTHER rate with a later `validFrom`, the history
/// is never rewritten. The rate in effect for a given date D is the row with
/// the MAXIMUM `validFrom <= D` (AD-4) — see
/// `instructor-rates.service.ts#getEffectiveInstructorRate`, the hook epic 5's
/// flight snapshot will call (not implemented here). `priceCentsPerHour` is an
/// integer number of euro cents (AD-2) and always > 0 — enforced at the
/// Zod/service boundary, not a DB constraint, same choice as `AircraftRate`.
/// `validFrom` is calendar-only (`@db.Date`, same convention as
/// `AccountMovement.effectiveDate`/`AircraftRate.validFrom`) — a rate takes
/// effect on a whole day, never at a specific time.
/// `@@unique([instructorProfileId, validFrom])` backs AC 2: two rates for the
/// same instructor on the same day is a 409, not a silent overwrite.
model InstructorRate {
  id                  String            @id @default(cuid())
  instructorProfileId String
  instructorProfile   InstructorProfile @relation(fields: [instructorProfileId], references: [id])
  priceCentsPerHour   Int
  validFrom           DateTime          @db.Date
  /// The acting `User.id` (`Actor.userId`, always present) — who recorded
  /// this rate, same rationale as `AircraftRate.actorUserId`.
  actorUserId         String
  actorUser           User              @relation(fields: [actorUserId], references: [id])
  createdAt           DateTime          @default(now())

  @@unique([instructorProfileId, validFrom])
  @@index([instructorProfileId])
}

/// Append-only audit trail for hour-meter (contaore) corrections (story 2.5,
/// AC 2; AD-3's spirit — no ledger storno here, a wrong entry is corrected by
/// another entry, never edited/deleted). Created exclusively inside
/// `adjustHourMeter`'s single Prisma transaction, alongside the
/// `Aircraft.hourMeterMinutes` update it audits — there is deliberately no
/// update/delete API. `previousMinutes`/`newMinutes` are both stored (rather
/// than just the delta) so the history reads without recomputation.
model HourMeterAdjustment {
  id              String   @id @default(cuid())
  aircraftId      String
  aircraft        Aircraft @relation(fields: [aircraftId], references: [id])
  /// The acting `User.id` (`Actor.userId`, always present) — not `personId`:
  /// a staff member performing the rectification may have no linked `Person`.
  actorUserId     String
  actorUser       User     @relation(fields: [actorUserId], references: [id])
  previousMinutes Int
  newMinutes      Int
  reason          String
  createdAt       DateTime @default(now())

  @@index([aircraftId])
}

/// Login credentials. 1-to-0/1 with `Person` (AD-11) — not every `Person` has
/// a login (e.g. a pilot who never receives an account), and not every `User`
/// needs a `Person` yet (kept optional to avoid coupling auth to the full
/// anagrafica before story 2.1 exists).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Nullable (story 1.4): an invited user has no password until they follow
  /// their invite link and set one via `AuthToken`. `authorize()` rejects
  /// login for a null `passwordHash` (with the same dummy-verify timing
  /// pattern used for "unknown email"/"inactive user" — see story 1.2/1.4).
  passwordHash String?
  isActive     Boolean @default(true)
  /// UI/email language (story 1.4, AD-7). Kept as a plain string rather than
  /// a Prisma enum so it maps 1:1 onto `next-intl`'s `AppLocale` ('it'|'en')
  /// without a translation layer; validated at the Zod boundary.
  locale       String  @default("it")
  roles        Role[]
  personId     String? @unique
  person       Person? @relation(fields: [personId], references: [id])

  authTokens           AuthToken[]
  /// Hour-meter rectifications this user performed (story 2.5, AC 2) —
  /// `HourMeterAdjustment.actorUserId`.
  hourMeterAdjustments HourMeterAdjustment[]
  /// Aircraft rates this user recorded (story 4.1) — `AircraftRate.actorUserId`.
  aircraftRates        AircraftRate[]
  /// Instructor rates this user recorded (story 4.2) — `InstructorRate.actorUserId`.
  instructorRates      InstructorRate[]
  /// Account ledger entries this user recorded (story 3.1) — `AccountMovement.actorUserId`.
  accountMovements     AccountMovement[]
  /// Cash ledger entries this user recorded (story 3.1) — `CashMovement.actorUserId`.
  cashMovements        CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, hashed tokens backing the invite and password-reset email
/// flows (story 1.4, AC 1/3). Only the sha256 hash of the token is ever
/// persisted — the raw value exists only in the emailed link and is never
/// logged or stored.
enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  expiresAt DateTime
  /// Set once the token is consumed — monouso (single-use), never deleted so
  /// a reused/replayed link can still be told apart from an unknown one.
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}

/// Prepaid account movement types (story 3.1, AD-3's ledger). `TOP_UP` (3.1)
/// and `ADJUSTMENT` (story 3.3 — a motivated correction, AC 1) are populated
/// today; flight debits (epic 5) grow this enum later. Additive migration
/// only (Dev Notes) — no existing row's `type` ever changes.
enum AccountMovementType {
  TOP_UP
  ADJUSTMENT
}

/// How a top-up was paid (story 3.1, AC 2). Only meaningful for `TOP_UP`
/// movements today — kept on `AccountMovement` rather than a separate table
/// since every current movement type needs at most this one extra field.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
}

/// Prepaid account (story 3.1, AC 1; AD-11): 1-to-0/1 with `Person`, NEVER
/// with a profile — `PilotProfile`/`StudentProfile` come and go (student to
/// pilot transition, deactivation) but the account and its whole ledger
/// history survive untouched, because it is anchored to the person, not the
/// role. Deliberately has NO balance column (AD-3): the balance is always
/// `SUM(AccountMovement.amountCents)`, computed in `accounts.service.ts`,
/// never a value written here.
model Account {
  id        String   @id @default(cuid())
  personId  String   @unique
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements AccountMovement[]
}

/// Append-only ledger of a person's account activity (story 3.1, AC 2/3;
/// AD-3's cardinal rule — this is the model that constraint is named after).
/// There is deliberately no update/delete API: a wrong entry is corrected by
/// a future storno movement referencing it via `reversalOfId` (story 3.3),
/// never by editing/removing this row. `amountCents` is SIGNED (AD-2) — a
/// top-up is positive; future movement types (debits) will be negative.
/// `paymentMethod` is only ever set for `TOP_UP` today. `actorUserId` (not
/// `personId`) records who *performed* the operation — same rationale as
/// `HourMeterAdjustment.actorUserId` (story 2.5): the staff member recording
/// a cash top-up is not the account holder.
model AccountMovement {
  id            String              @id @default(cuid())
  accountId     String
  account       Account             @relation(fields: [accountId], references: [id])
  type          AccountMovementType
  amountCents   Int
  paymentMethod PaymentMethod?
  description   String?
  /// Value date (data valuta), calendar-only like `StudentProfile.courseStartDate`
  /// (story 2.2) — never a timestamp.
  effectiveDate DateTime            @db.Date
  actorUserId   String
  actorUser     User                @relation(fields: [actorUserId], references: [id])
  /// Self-FK to the original movement this one reverses (AD-3 storno,
  /// story 3.3). `@unique` — at most one reversal per original movement.
  reversalOfId  String?             @unique
  reversalOf    AccountMovement?    @relation("AccountMovementReversal", fields: [reversalOfId], references: [id])
  reversal      AccountMovement?    @relation("AccountMovementReversal")
  createdAt     DateTime            @default(now())

  /// The automatic cash-ledger counterpart created in the same transaction
  /// (story 3.1, AC 2) — present only for movement types that also move cash
  /// (today, every `TOP_UP`).
  cashMovement CashMovement?

  @@index([accountId])
}

/// Cash-ledger categories (story 3.1; full list assumed seeded per Dev Notes,
/// story 3.4 owns further management UI). `isActive` lets a category be
/// retired from new-movement pickers without breaking historical
/// `CashMovement` rows that already reference it.
model CashCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements CashMovement[]
}

/// Append-only cash-register ledger (story 3.1, AC 2; AD-3 — same
/// append-only/storno rule as `AccountMovement`, no update/delete API).
/// `amountCents` is SIGNED (AD-2): an entrata (e.g. a top-up) is positive, a
/// uscita is negative. `accountMovementId` links the automatic cash entry
/// back to the `AccountMovement` (a top-up) that generated it — traceability,
/// and the unique constraint caps the twin relation at one cash movement per
/// account movement. NOTE: this does NOT make the top-up REQUEST idempotent —
/// two identical POSTs still create two independent movement pairs (review
/// 3.1 F2, deferred); manual cash movements (story 3.4) leave it `null`.
model CashMovement {
  id                String           @id @default(cuid())
  categoryId        String
  category          CashCategory     @relation(fields: [categoryId], references: [id])
  amountCents       Int
  description       String?
  /// Value date (data valuta) — same calendar-only convention as `AccountMovement.effectiveDate`.
  effectiveDate     DateTime         @db.Date
  actorUserId       String
  actorUser         User             @relation(fields: [actorUserId], references: [id])
  accountMovementId String?          @unique
  accountMovement   AccountMovement? @relation(fields: [accountMovementId], references: [id])
  /// Self-FK to the original movement this one reverses (AD-3 storno, story 3.3/3.4).
  reversalOfId      String?          @unique
  reversalOf        CashMovement?    @relation("CashMovementReversal", fields: [reversalOfId], references: [id])
  reversal          CashMovement?    @relation("CashMovementReversal")
  createdAt         DateTime         @default(now())
}
