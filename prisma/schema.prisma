// AirManager — Prisma schema
// See https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Generic key/value application setting. First minimal model for story 1.1
/// scaffolding; domain models arrive in later stories per the architecture spine.
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// System roles. Full permission mapping (AD-5) lands in story 1.3 — here the
/// enum only exists so `User.roles` can be populated at login time.
enum Role {
  ADMIN
  INSTRUCTOR
  PILOT
  STUDENT
}

/// Person registry (AD-11: a single `Person` record per human being; FR-4:
/// one unique anagrafica, no duplicates). Story 1.2 introduced the minimal
/// shape (name + optional email) to attach a display name to an
/// authenticated user; story 2.1 extends it with the full CRUD fields
/// (`phone`/`address`) plus archiving.
model Person {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  email      String?   @unique
  phone      String?
  address    String?
  /// Soft-archive timestamp (story 2.1, AC 2): a timestamp rather than a
  /// boolean also records *when* — and there is deliberately no physical
  /// delete API for a `Person` (historical flights/movements must keep
  /// referencing it).
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user              User?
  pilotProfile      PilotProfile?
  studentProfile    StudentProfile?
  instructorProfile InstructorProfile?
  /// Prepaid account (story 3.1, AD-11): 1-to-0/1 with `Person`, never the
  /// profile — a student->pilot transition never touches it.
  account           Account?
  /// Sold hour packages (epic 4, story 4.4, AD-11): belongs to the PERSON,
  /// never a profile — same rationale as `account` (survives a
  /// student->pilot transition). See `HourPackage` doc.
  hourPackages      HourPackage[]
  /// Flights this person flew/paid for (epic 5, story 5.1, AD-11): belongs
  /// to the PERSON, never a profile — same rationale as `account`. See
  /// `Flight` doc.
  flights           Flight[]
  /// This person's abilitative scadenze (epic 6, story 6.2, AD-11): belongs
  /// to the PERSON, never a profile — same rationale as `account`/
  /// `hourPackages`/`flights` (survives a student->pilot transition). See
  /// `Expiry` doc.
  expiries          Expiry[]
  /// Bookings held FOR this person (epic 7, story 7.1, AD-11): belongs to
  /// the PERSON, never a profile — same rationale as `flights` (survives a
  /// student->pilot transition). See `Booking` doc.
  bookings          Booking[]
}

/// Pilot profile (story 2.2, AC 1/2, AD-11): 1-to-0/1 with `Person`, never a
/// second `Person` row. `deactivatedAt` soft-disables the profile (same
/// rationale as `Person.archivedAt`) instead of deleting the row — future
/// epics (4/5/9) attach rates/flights/training notes to a profile and that
/// history must survive a student→pilot transition or any other
/// deactivation. Reactivating (AC 2) just clears `deactivatedAt` again.
model PilotProfile {
  id            String    @id @default(cuid())
  personId      String    @unique
  person        Person    @relation(fields: [personId], references: [id])
  licenseNumber String
  licenseType   String
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Student ("allievo") profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile`
/// doc for the 1-to-0/1 + soft-deactivation rationale, identical here.
/// `courseStartDate` is a calendar date only (no time-of-day), `@db.Date` so
/// Postgres never stores a time/timezone component for it.
model StudentProfile {
  id              String    @id @default(cuid())
  personId        String    @unique
  person          Person    @relation(fields: [personId], references: [id])
  courseStartDate DateTime  @db.Date
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Instructors assigned to this student (epic 9, story 9.1, FR-32) — see `StudentInstructorAssignment` doc.
  instructorAssignments StudentInstructorAssignment[]
  /// Training diary entries about this student (epic 9, story 9.2, FR-33) — see `TrainingNote` doc.
  trainingNotes         TrainingNote[]
}

/// Instructor profile (story 2.2, AC 1/2, AD-11) — see `PilotProfile` doc for
/// the 1-to-0/1 + soft-deactivation rationale, identical here. The free-text
/// `ratings` field (MVP-era, e.g. "SEP(land), FI(A)") was REMOVED in story
/// 13.1 (R-13.1-b): instructor abilitazioni now live as `Expiry` rows on
/// `ExpiryType`s scoped `INSTRUCTORS` — the SAME catalogue/mechanism piloti
/// use, never a parallel free-text field. The migration
/// (`20260722190100_drop_instructor_profile_ratings`) does NOT migrate the
/// old free text into `Expiry` rows automatically (unreliable name parsing);
/// existing instructors' abilitazioni are reassigned manually.
model InstructorProfile {
  id              String    @id @default(cuid())
  personId        String    @unique
  person          Person    @relation(fields: [personId], references: [id])
  /// Hourly PAYOUT rate (epic 12, story 12.7) — what the airfield pays THIS
  /// instructor per hour taught, in euro cents. Deliberately a single
  /// mutable column, NOT historicized like `InstructorRate` (the rate
  /// charged TO the student, story 4.2): the payout ledger (`InstructorPayout`
  /// below) already carries its own dated rows, so there is no "what was the
  /// rate on date D" question to answer for this field the way AD-4 answers
  /// it for `InstructorRate`. `null` until an admin sets one (`setPayoutRate`,
  /// `payouts.manage`) — the UI shows "—" and `owed` is always `null` for
  /// that instructor until then.
  payoutRateCents Int?
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Historicized hourly rates (epic 4, story 4.2, AD-4) — see `InstructorRate` doc.
  rates                 InstructorRate[]
  /// Payout ledger entries recorded for this instructor (epic 12, story 12.7) — see `InstructorPayout` doc.
  payouts               InstructorPayout[]
  /// Flights where this profile was the instructor aboard (epic 5, story 5.1) — see `Flight` doc.
  flights               Flight[]
  /// Bookings where this profile is the indicated instructor (epic 7, story 7.1) — see `Booking` doc.
  bookings              Booking[]
  /// Students assigned to this instructor (epic 9, story 9.1, FR-32) — see `StudentInstructorAssignment` doc.
  studentAssignments    StudentInstructorAssignment[]
  /// Training diary entries authored by this instructor (epic 9, story 9.2, FR-33) — see `TrainingNote` doc.
  trainingNotesAuthored TrainingNote[]
}

/// Instructor payout ledger (epic 12, story 12.7) — an append-only record of
/// what the airfield actually PAID an instructor for a period, the money
/// side of `InstructorProfile.payoutRateCents`'s hourly rate. `amountCents`
/// is the amount paid (always positive — a payout is never negative here,
/// there is no reversal concept for this MVP ledger). `periodStart`/
/// `periodEnd` are calendar-only (`@db.Date`, Rome day, same convention as
/// `AircraftRate.validFrom`) and bound the SCHOOL-flight hours this payout
/// covers — `periodStart <= periodEnd`, enforced at the service boundary.
/// Attribution to a summary variant (mtd/ytd/total,
/// `instructor-compensation.service.ts#getCompensationSummary`) is ALWAYS by
/// `periodEnd` falling inside the variant's range — a deterministic,
/// index-backed rule (see `@@index` below), never by `createdAt`.
/// `actorUserId` is who recorded the payout (same audit pattern as every
/// other ledger's `actorUserId`). There is deliberately no update/delete API
/// (AD-3's spirit) — a wrong entry is corrected by a future payout, never by
/// rewriting history.
model InstructorPayout {
  id                  String            @id @default(cuid())
  instructorProfileId String
  instructorProfile   InstructorProfile @relation(fields: [instructorProfileId], references: [id])
  amountCents         Int
  periodStart         DateTime          @db.Date
  periodEnd           DateTime          @db.Date
  method              PaymentMethod
  notes               String?
  actorUserId         String
  actorUser           User              @relation("InstructorPayoutActor", fields: [actorUserId], references: [id])
  createdAt           DateTime          @default(now())

  /// The automatic cash-ledger counterpart created in the same transaction
  /// (story Billing-1, AC 4) — the outbound money side of the payout, under
  /// the "Compensi istruttori" category, so the payout finally shows up as a
  /// cost/uscita (before this it only ever created this row, never touching
  /// `CashMovement`). Same 1-to-0/1 traceability pattern as
  /// `AccountMovement.cashMovement`.
  cashMovement CashMovement?

  @@index([instructorProfileId, periodEnd])
}

/// Many-to-many assignment between a student and their instructor(s) (epic 9,
/// story 9.1, FR-32; AD-11: links the two existing PROFILES, never a new
/// person-like table). A student may have several instructors and an
/// instructor several students — `@@unique` only forbids assigning the SAME
/// pair twice (a duplicate attempt is a 409 at the service layer). Hard
/// -deleted on removal (Contesto: "hard delete, nessuno storico richiesto dal
/// PRD") — `assignedByUserId`/`createdAt` are the only audit trail (who/when
/// assigned it), same tracking pattern as `AircraftRate.actorUserId`;
/// there is deliberately no "unassigned by/at" pair since the row is simply
/// gone. FK RESTRICT (Prisma default, no `onDelete` set) — a profile can
/// never be physically deleted anyway (AD-11's soft-deactivation-only rule),
/// so this is purely defensive.
model StudentInstructorAssignment {
  id                  String            @id @default(cuid())
  studentProfileId    String
  studentProfile      StudentProfile    @relation(fields: [studentProfileId], references: [id])
  instructorProfileId String
  instructorProfile   InstructorProfile @relation(fields: [instructorProfileId], references: [id])
  assignedByUserId    String
  assignedByUser      User              @relation(fields: [assignedByUserId], references: [id])
  createdAt           DateTime          @default(now())

  @@unique([studentProfileId, instructorProfileId])
}

/// Training diary entry (epic 9, story 9.2, FR-33) — an instructor's
/// progress note about an assigned student. `instructorProfileId` is the
/// AUTHOR and is immutable (never reassigned by an edit). `noteDate` is the
/// calendar date of the TRAINING SESSION (`@db.Date`) — deliberately
/// distinct from `createdAt`: an instructor may log a note days after the
/// lesson. `flightId` is an OPTIONAL, NON-unique link to a `SCHOOL` flight of
/// this student (`school.service.ts` validates flightType/personId at write
/// time) — several notes may reference the same flight (Contesto: "la nota è
/// cronaca, non contabilità" — a note stays valid even if the linked flight
/// is later deleted: its `flightId` goes `NULL`, `ON DELETE SET NULL`). `exercises` is mandatory; `assessment`/`nextSteps` are free-text
/// and optional. Immutable after 7 days from `createdAt` (`school.service.ts`,
/// AC 3) — enforced in the service, not at the DB level; there is
/// deliberately no delete endpoint (Contesto: immutability, no history
/// requirement beyond `updatedAt`). FK RESTRICT (Prisma default, no
/// `onDelete` set) on the two required profile FKs, same defensive rationale
/// as `StudentInstructorAssignment` — neither profile is ever physically
/// deleted (AD-11).
model TrainingNote {
  id                  String            @id @default(cuid())
  studentProfileId    String
  studentProfile      StudentProfile    @relation(fields: [studentProfileId], references: [id])
  instructorProfileId String
  instructorProfile   InstructorProfile @relation(fields: [instructorProfileId], references: [id])
  noteDate            DateTime          @db.Date
  flightId            String?
  flight              Flight?           @relation(fields: [flightId], references: [id])
  exercises           String
  assessment          String?
  nextSteps           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([studentProfileId, noteDate])
}

/// Aircraft operational status (story 2.5, AC 1; FR-8). `OUT_OF_SERVICE` is
/// deliberately distinct from `Aircraft.archivedAt` (story 2.4): an
/// out-of-service aircraft is still active fleet, just not bookable — the
/// real booking block is Epic 7, this enum only carries the flag/reason.
enum AircraftStatus {
  OPERATIONAL
  OUT_OF_SERVICE
}

/// Aircraft fleet registry (story 2.4, AC 1/2; FR-7). `registration` (marche,
/// e.g. "I-ABCD") is the unique human-facing identifier — normalized
/// (`trim().toUpperCase()`) at the Zod boundary so the DB-level uniqueness is
/// case-insensitive in practice. The airframe's hours are not stored here
/// (story 19.2, R-19-b): wherever shown, they are the sum of its flights'
/// `minutes` (`aircraft.service.ts#sumFlightMinutesByAircraft`).
/// `status`/`statusReason` (story 2.5,
/// AC 1) are the operational flag: `statusReason` is populated only while
/// `OUT_OF_SERVICE` and cleared on return to service. Rates (`AircraftRate`,
/// epic 4) are deliberately out of scope here — this model is anagrafica
/// only. `archivedAt` follows the same soft-archive pattern as
/// `Person.archivedAt` (story 2.1): a timestamp rather than a boolean, no
/// physical-delete API, since future flights/rates reference the aircraft by
/// id.
model Aircraft {
  id                String         @id @default(cuid())
  registration      String         @unique
  type              String
  model             String
  status            AircraftStatus @default(OPERATIONAL)
  /// Mandatory while `status == OUT_OF_SERVICE`; reset to `null` on return to
  /// service (enforced in `aircraft.service.ts`, not at the DB level).
  statusReason      String?
  /// Expected end of the grounding (story AOG-1a, requirement P3), calendar-only.
  /// THE SINGLE SOURCE OF THIS FIELD'S SEMANTICS — service, i18n and the
  /// `AIRCRAFT_OUT_OF_SERVICE` 422 messages all cite this comment, none of them
  /// re-interprets it:
  /// (i) SEMANTICS (ratifica R-AOG-a, PO 2026-08-07): the LAST day the aircraft
  ///     is GROUNDED, INCLUSIVE — the grounding window is `[now, end of the
  ///     `outOfServiceUntil` day]`, so a booking/flight ON that day is still
  ///     inside the fermo. UI label: "Fermo fino al {data} compreso".
  /// (ii) INFORMATIVE (invariant [a]): it NEVER returns the aircraft to service
  ///     by itself — no job, no cron, no `where` that filters out an "expired"
  ///     grounding. Only an explicit `returnToService` does, and every guard
  ///     (bookings, flights) keeps reading `status` alone.
  /// (iii) SAME LIFE-CYCLE AS `statusReason`: written together with it by
  ///     `setOutOfService`, reset to `null` by `returnToService` — enforced in
  ///     `aircraft.service.ts`, not at the DB level.
  /// (iv) OPTIONAL (invariant [b]): `null` means "return date not yet known" and
  ///     is a legitimate state, not a missing value to be filled in.
  outOfServiceUntil DateTime?      @db.Date
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Historicized hourly rates (epic 4, story 4.1, AD-4) — see `AircraftRate` doc.
  rates        AircraftRate[]
  /// Package types this aircraft is eligible for (epic 4, story 4.3) — see `PackageTypeAircraft` doc.
  packageTypes PackageTypeAircraft[]
  /// Flights logged on this airframe (epic 5, story 5.1) — see `Flight` doc.
  flights      Flight[]
  /// Bookings held on this airframe (epic 7, story 7.1) — see `Booking` doc.
  bookings     Booking[]
}

/// Historicized hourly rate (story 4.1, epic 4; AD-4/AD-2). TWO billed
/// prices (story 19.3, R-19-e): `studentPriceCents` and `pilotPriceCents`,
/// both integer euro cents (AD-2) and always > 0 — enforced at the
/// Zod/service boundary, not a DB constraint. A flight takes the column of
/// the PROFILE of whoever flies it (`flights.service.ts#resolveFlightInput`)
/// and freezes it, together with the category it applied
/// (`Flight.aircraftPriceCategory`). The rate in effect for a given date D is
/// the row with the MAXIMUM `validFrom <= D` (AD-4) — see
/// `rates.service.ts#getEffectiveRate`, read by the flight snapshot.
/// `validFrom` is calendar-only (`@db.Date`, same convention as
/// `AccountMovement.effectiveDate`) — a rate takes effect on a whole day,
/// never at a specific time. Writes (story 19.3, R-19-f): `validFrom` must be
/// today or later (Europe/Rome calendar, A16 — `RATE_VALID_FROM_IN_PAST`),
/// and a row whose `validFrom` is today or later is REWRITTEN in place by a
/// second write on the same day (`@@unique([aircraftId, validFrom])` backs
/// the upsert, `rates.service.ts#upsertAircraftRateCore`) — a row before
/// today never changes; today's row can still be rewritten, and a flight
/// already registered today keeps the price it froze (AD-4: both prices were
/// legitimate at that instant). The history stays in the DB (and on `GET .../rates` for API
/// clients); the UI shows only the current rate and the next scheduled one.
model AircraftRate {
  id                 String   @id @default(cuid())
  aircraftId         String
  aircraft           Aircraft @relation(fields: [aircraftId], references: [id])
  studentPriceCents  Int
  pilotPriceCents    Int
  validFrom          DateTime @db.Date
  /// The acting `User.id` (`Actor.userId`, always present) — who recorded
  /// this rate. Not `personId`: a staff member recording it may have no
  /// linked `Person`.
  actorUserId        String
  actorUser          User     @relation(fields: [actorUserId], references: [id])
  createdAt          DateTime @default(now())

  @@unique([aircraftId, validFrom])
  @@index([aircraftId])
}

/// Historicized hourly rate for an instructor (story 4.2, epic 4; AD-4/AD-2)
/// — the twin of `AircraftRate`, same rules, keyed on `instructorProfileId`
/// instead of `aircraftId`, with ONE price. The rate in effect for a given
/// date D is the row with the MAXIMUM `validFrom <= D` (AD-4) — see
/// `instructor-rates.service.ts#getEffectiveInstructorRate`, read by the
/// flight snapshot. `priceCentsPerHour` is an integer number of euro cents
/// (AD-2) and always > 0 — enforced at the Zod/service boundary, not a DB
/// constraint, same choice as `AircraftRate`. `validFrom` is calendar-only
/// (`@db.Date`, same convention as `AircraftRate.validFrom`). Writes (story
/// 19.3, R-19-f): `validFrom` today or later (Europe/Rome, A16), and a row
/// whose `validFrom` is today or later is rewritten in place
/// (`@@unique([instructorProfileId, validFrom])` backs the upsert,
/// `instructor-rates.service.ts#upsertInstructorRateCore`). The history stays
/// in the DB, not in the UI.
model InstructorRate {
  id                  String            @id @default(cuid())
  instructorProfileId String
  instructorProfile   InstructorProfile @relation(fields: [instructorProfileId], references: [id])
  priceCentsPerHour   Int
  validFrom           DateTime          @db.Date
  /// The acting `User.id` (`Actor.userId`, always present) — who recorded
  /// this rate, same rationale as `AircraftRate.actorUserId`.
  actorUserId         String
  actorUser           User              @relation(fields: [actorUserId], references: [id])
  createdAt           DateTime          @default(now())

  @@unique([instructorProfileId, validFrom])
  @@index([instructorProfileId])
}

/// Login credentials. 1-to-0/1 with `Person` (AD-11) — not every `Person` has
/// a login (e.g. a pilot who never receives an account), and not every `User`
/// needs a `Person` yet (kept optional to avoid coupling auth to the full
/// anagrafica before story 2.1 exists).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Nullable (story 1.4): an invited user has no password until they follow
  /// their invite link and set one via `AuthToken`. `authorize()` rejects
  /// login for a null `passwordHash` (with the same dummy-verify timing
  /// pattern used for "unknown email"/"inactive user" — see story 1.2/1.4).
  passwordHash String?
  isActive     Boolean @default(true)
  /// Session-version watermark (story TD-6, F1, CWE-613). Stamped into the
  /// JWT at sign-in and compared against this column in
  /// `applyActiveRecheck`; `setPasswordWithToken` bumps it inside the same
  /// transaction as the password change, so every session issued before the
  /// bump fails the next recheck (a stale OR entirely missing claim both
  /// count as a mismatch) and is evicted within `ACTIVE_RECHECK_INTERVAL_MS`
  /// — bounding a stolen session's post-reset survival instead of leaving it
  /// valid for the JWT's full 30-day lifetime.
  tokenVersion Int     @default(0)
  /// UI/email language (story 1.4, AD-7). Kept as a plain string rather than
  /// a Prisma enum so it maps 1:1 onto `next-intl`'s `AppLocale` ('it'|'en')
  /// without a translation layer; validated at the Zod boundary.
  locale       String  @default("it")
  roles        Role[]
  personId     String? @unique
  person       Person? @relation(fields: [personId], references: [id])

  authTokens                          AuthToken[]
  /// Aircraft rates this user recorded (story 4.1) — `AircraftRate.actorUserId`.
  aircraftRates                       AircraftRate[]
  /// Instructor rates this user recorded (story 4.2) — `InstructorRate.actorUserId`.
  instructorRates                     InstructorRate[]
  /// Account ledger entries this user recorded (story 3.1) — `AccountMovement.actorUserId`.
  accountMovements                    AccountMovement[]
  /// Cash ledger entries this user recorded (story 3.1) — `CashMovement.actorUserId`.
  cashMovements                       CashMovement[]
  /// Package sales this user recorded (story 4.4) — `HourPackage.actorUserId`.
  hourPackagesSold                    HourPackage[]
  /// Flights this user registered (epic 5, story 5.1) — `Flight.actorUserId`.
  flightsRecorded                     Flight[]
  /// Bookings this user created (epic 7, story 7.1) — `Booking.actorUserId`.
  bookingsRecorded                    Booking[]                     @relation("BookingActor")
  /// Bookings this user last EDITED (epic 7, story 7.3, AC 2) — `Booking.updatedByUserId`.
  bookingsUpdated                     Booking[]                     @relation("BookingUpdatedBy")
  /// Bookings this user CANCELLED (epic 7, story 7.3, AC 2) — `Booking.cancelledByUserId`.
  bookingsCancelled                   Booking[]                     @relation("BookingCancelledBy")
  /// Bookings this user FORCED past a blocking expired document (epic 7, story 7.4, AC 2) — `Booking.forcedByUserId`.
  bookingsForced                      Booking[]                     @relation("BookingForcedBy")
  /// Flights this user FORCED past a blocking expired document (epic 14, story 14.4, AC 2) — `Flight.forcedByUserId`.
  flightsForced                       Flight[]                      @relation("FlightForcedBy")
  /// Bookings this user APPROVED or DENIED (epic 12, story 12.2, AC 3) — `Booking.decidedByUserId`.
  bookingsDecided                     Booking[]                     @relation("BookingDecidedBy")
  /// Bookings this user marked FLOWN or NO_SHOW (epic 12, story 12.2, AC 3) — `Booking.closedByUserId`.
  bookingsClosed                      Booking[]                     @relation("BookingClosedBy")
  /// Scadenze this user registered/last updated (epic 6, story 6.2) — `Expiry.actorUserId`.
  expiriesRecorded                    Expiry[]
  /// Update proposals this user FILED, as the scadenza's titolare (epic 6, story 6.2) — `ExpiryUpdateProposal.proposedByUserId`.
  expiryProposalsFiled                ExpiryUpdateProposal[]        @relation("ExpiryProposalProposedBy")
  /// Update proposals this user DECIDED, as staff (epic 6, story 6.2) — `ExpiryUpdateProposal.decidedByUserId`.
  expiryProposalsDecided              ExpiryUpdateProposal[]        @relation("ExpiryProposalDecidedBy")
  /// Idempotency-key ledger for this user's money-mutating POSTs (story TD-2) — `IdempotencyRecord.userId`.
  idempotencyRecords                  IdempotencyRecord[]
  /// Student-instructor assignments this user CREATED (epic 9, story 9.1) — `StudentInstructorAssignment.assignedByUserId`.
  studentInstructorAssignmentsCreated StudentInstructorAssignment[]
  /// Instructor payouts this user recorded (epic 12, story 12.7) — `InstructorPayout.actorUserId`.
  instructorPayouts                   InstructorPayout[]            @relation("InstructorPayoutActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, hashed tokens backing the invite and password-reset email
/// flows (story 1.4, AC 1/3). Only the sha256 hash of the token is ever
/// persisted — the raw value exists only in the emailed link and is never
/// logged or stored.
enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  expiresAt DateTime
  /// Set once the token is consumed — monouso (single-use), never deleted so
  /// a reused/replayed link can still be told apart from an unknown one.
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
}

/// Login brute-force / credential-stuffing throttle (H1, CWE-307,
/// `docs/security/owasp-audit-2026-07-22.md`) — one row per Credentials
/// provider `authorize()` outcome, counted in a rolling window by
/// `login-throttle.ts`. No relation to `User`: `identifier` is the raw
/// (lowercased) email from the login form, recorded even when it matches no
/// account — an unknown-email guess must count toward its own throttle
/// bucket exactly like a wrong password, or an attacker could distinguish
/// "locked" from "unknown" by which one never accumulates failures.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  /// `null` when no `x-forwarded-for` is resolvable (trust assumption in
  /// `client-ip.ts#extractClientIp`) — `login-throttle.ts` then falls back to
  /// the per-identifier check alone rather than skipping the throttle (H5
  /// lesson: a missing IP must never be a free pass).
  ip         String?
  succeeded  Boolean
  createdAt  DateTime @default(now())

  /// Backs the per-identifier rolling-window failure count.
  @@index([identifier, createdAt])
  /// Backs the per-IP rolling-window failure count.
  @@index([ip, createdAt])
}

/// `forgot-password` mail-bomb / token-churn throttle (H4, CWE-799/307,
/// `docs/security/owasp-audit-2026-07-22.md`) — one row per ALLOWED
/// `requestPasswordReset` call (throttled calls write nothing, same
/// "don't let a flood re-extend its own window" reasoning as
/// `LoginAttempt`), counted in a rolling window by
/// `auth-tokens.service.ts#isPasswordResetThrottled`. No relation to
/// `User`: `email` is recorded whether or not it matches an account, so the
/// throttle itself never becomes an enumeration signal.
model PasswordResetAttempt {
  id        String   @id @default(cuid())
  email     String
  /// `null` when no `x-forwarded-for` is resolvable — the per-email check
  /// still applies (same fallback reasoning as `LoginAttempt.ip`).
  ip        String?
  createdAt DateTime @default(now())

  /// Backs the per-email rolling-window request count.
  @@index([email, createdAt])
  /// Backs the per-IP rolling-window request count.
  @@index([ip, createdAt])
}

/// Prepaid account movement types (story 3.1, AD-3's ledger). `TOP_UP` (3.1)
/// and `ADJUSTMENT` (story 3.3 — a motivated correction, AC 1) are populated
/// today; `PACKAGE_PURCHASE` (story 4.4, AC 1) is the estratto-conto row a
/// package sale creates — always `amountCents: 0` (the payment is external
/// to the account, see `HourPackage` doc), it exists purely so the titolare
/// sees the purchase in their statement. `FLIGHT_CHARGE` (epic 5, story 5.1;
/// FR-14/FR-15) is the first REAL debit: `amountCents` is NEGATIVE (aircraft
/// cost + optional instructor cost) and the balance is allowed to go
/// negative — see `Flight`'s doc for the snapshot it links to via
/// `AccountMovement.flightId`. A flight's charge lives and dies with the
/// flight (story 19.6, R-19-c — AD-3's only exception): editing the flight
/// rewrites it in place, deleting the flight deletes it, so no reversal type
/// exists for it (the storno type story 5.3 added was retired with its rows).
enum AccountMovementType {
  TOP_UP
  ADJUSTMENT
  PACKAGE_PURCHASE
  FLIGHT_CHARGE
}

/// How a top-up was paid (story 3.1, AC 2). Only meaningful for `TOP_UP`
/// movements today — kept on `AccountMovement` rather than a separate table
/// since every current movement type needs at most this one extra field.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
}

/// Prepaid account (story 3.1, AC 1; AD-11): 1-to-0/1 with `Person`, NEVER
/// with a profile — `PilotProfile`/`StudentProfile` come and go (student to
/// pilot transition, deactivation) but the account and its whole ledger
/// history survive untouched, because it is anchored to the person, not the
/// role. Deliberately has NO balance column (AD-3): the balance is always
/// `SUM(AccountMovement.amountCents)`, computed in `accounts.service.ts`,
/// never a value written here.
model Account {
  id        String   @id @default(cuid())
  personId  String   @unique
  person    Person   @relation(fields: [personId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements AccountMovement[]
}

/// Append-only ledger of a person's account activity (story 3.1, AC 2/3;
/// AD-3's cardinal rule — this is the model that constraint is named after).
/// There is deliberately no update/delete API: a wrong entry is corrected by
/// a future storno movement referencing it via `reversalOfId` (story 3.3),
/// never by editing/removing this row. ONE exception (story 19.6, R-19-c,
/// AD-3 as amended): a `FLIGHT_CHARGE` (the only type linked to a `Flight`)
/// is updated in place by `flights.service.ts#updateFlight` and deleted by
/// `deleteFlight`, together with its flight, in the same transaction. `amountCents` is SIGNED (AD-2) — a
/// top-up is positive; future movement types (debits) will be negative.
/// `paymentMethod` is only ever set for `TOP_UP` today. `actorUserId` (not
/// `personId`) records who *performed* the operation — same rationale as
/// `AircraftRate.actorUserId`: the staff member recording a cash top-up is
/// not the account holder.
model AccountMovement {
  id            String              @id @default(cuid())
  accountId     String
  account       Account             @relation(fields: [accountId], references: [id])
  type          AccountMovementType
  amountCents   Int
  paymentMethod PaymentMethod?
  description   String?
  /// Value date (data valuta), calendar-only like `StudentProfile.courseStartDate`
  /// (story 2.2) — never a timestamp.
  effectiveDate DateTime            @db.Date
  actorUserId   String
  actorUser     User                @relation(fields: [actorUserId], references: [id])
  /// Self-FK to the original movement this one reverses (AD-3 storno,
  /// story 3.3). `@unique` — at most one reversal per original movement.
  reversalOfId  String?             @unique
  reversalOf    AccountMovement?    @relation("AccountMovementReversal", fields: [reversalOfId], references: [id])
  reversal      AccountMovement?    @relation("AccountMovementReversal")
  createdAt     DateTime            @default(now())

  /// The automatic cash-ledger counterpart created in the same transaction
  /// (story 3.1, AC 2) — present only for movement types that also move cash
  /// (today, every `TOP_UP` and every `PACKAGE_PURCHASE`).
  cashMovement CashMovement?
  /// The `HourPackage` this movement is the estratto-conto twin of (story
  /// 4.4) — present only for `PACKAGE_PURCHASE` rows, same 1-to-0/1 pattern
  /// as `cashMovement`.
  hourPackage  HourPackage?
  /// The `Flight` this movement charges for (epic 5, story 5.1) — present
  /// only for `FLIGHT_CHARGE` rows. `@unique` (story 19.6, AD-7): exactly one
  /// charge per flight, guaranteed by the DB. `onDelete: Restrict`: a flight
  /// cannot be deleted while its charge exists — `deleteFlight` deletes the
  /// charge first, so no movement is ever orphaned.
  flightId     String?       @unique
  flight       Flight?       @relation(fields: [flightId], references: [id], onDelete: Restrict)

  @@index([accountId])
}

/// Cash-ledger categories (story 3.1; full list assumed seeded per Dev Notes,
/// story 3.4 owns further management UI). `isActive` lets a category be
/// retired from new-movement pickers without breaking historical
/// `CashMovement` rows that already reference it.
model CashCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements CashMovement[]
}

/// Append-only cash-register ledger (story 3.1, AC 2; AD-3 — same
/// append-only/storno rule as `AccountMovement`, no update/delete API).
/// `amountCents` is SIGNED (AD-2): an entrata (e.g. a top-up) is positive, a
/// uscita is negative. `accountMovementId` links the automatic cash entry
/// back to the `AccountMovement` (a top-up) that generated it — traceability,
/// and the unique constraint caps the twin relation at one cash movement per
/// account movement. NOTE: this does NOT make the top-up REQUEST idempotent —
/// two identical POSTs still create two independent movement pairs (review
/// 3.1 F2, deferred); manual cash movements (story 3.4) leave it `null`.
model CashMovement {
  id                 String            @id @default(cuid())
  categoryId         String
  category           CashCategory      @relation(fields: [categoryId], references: [id])
  amountCents        Int
  description        String?
  /// Value date (data valuta) — same calendar-only convention as `AccountMovement.effectiveDate`.
  effectiveDate      DateTime          @db.Date
  /// How this movement moved money (story Billing-1, AC 1) — nullable for
  /// the historical rows recorded before this field existed ("non
  /// attribuito", surfaced as a dedicated bucket, reachable/reclassifiable
  /// via `PATCH /api/v1/cash-movements/{id}`, story Billing-2 AC 3). New
  /// registrations always set it: `recordCashMovement`'s form makes it
  /// mandatory (review Billing-1 F8/D2), `recordTopUp`'s twin inherits it from the
  /// `TOP_UP`'s own `paymentMethod`. Backfilled once, in the migration that
  /// added this column, for every "Ricariche" twin from its linked
  /// `AccountMovement.paymentMethod` — every other historical row stays `null`.
  paymentMethod      PaymentMethod?
  actorUserId        String
  actorUser          User              @relation(fields: [actorUserId], references: [id])
  accountMovementId  String?           @unique
  accountMovement    AccountMovement?  @relation(fields: [accountMovementId], references: [id])
  /// Self-FK to the original movement this one reverses (AD-3 storno, story 3.3/3.4).
  reversalOfId       String?           @unique
  reversalOf         CashMovement?     @relation("CashMovementReversal", fields: [reversalOfId], references: [id])
  reversal           CashMovement?     @relation("CashMovementReversal")
  /// The `InstructorPayout` this movement is the money twin of (story
  /// Billing-1, AC 4) — present only for the automatic "Compensi istruttori"
  /// movement `recordPayout` creates, negative (an uscita). Same
  /// `accountMovementId @unique` twin-traceability pattern above, mirrored
  /// for this second kind of automatic twin.
  instructorPayoutId String?           @unique
  instructorPayout   InstructorPayout? @relation(fields: [instructorPayoutId], references: [id])
  createdAt          DateTime          @default(now())
}

/// Package-type catalogue (epic 4, story 4.3; FR-12). MUTABLE listino
/// configuration — like `CashCategory` — NOT an append-only ledger: it is
/// created, edited and deactivated freely, and deleted ONLY while never
/// sold. This is legal because the sale (story 4.4) will SNAPSHOT
/// `includedMinutes`/`priceCents` onto the sold `HourPackage`/
/// `AccountMovement` at the moment of purchase (AD-4, the same principle as
/// the historicized rates) — changing the catalogue afterwards never
/// rewrites that history. `includedMinutes` is an integer number of minutes
/// (AD-2 — same cardinal rule as `Flight.minutes`), never a
/// decimal-hours float. `priceCents` is an integer number of euro cents
/// (AD-2), always > 0, enforced at the Zod/service boundary (not a DB
/// constraint, same choice as `AircraftRate`'s two prices). The
/// "effective hourly price" shown in the UI is derived from these two
/// fields at render time and is NEVER persisted. `validityMonths` is the
/// optional validity of a sold package, in whole months; `null` means no
/// expiry. `isActive` hides the type from the future sale picker (story
/// 4.4) without touching any history already sold under it — same
/// lifecycle role as `CashCategory.isActive`. Delete is allowed ONLY while
/// never sold: today (story 4.3) no FK references this table yet; story 4.4
/// adds `HourPackage.packageTypeId` with `ON DELETE RESTRICT`, and
/// `package-types.service.ts#deletePackageType`'s `P2003` catch is already
/// the 409 backstop for that constraint (AC 2).
model PackageType {
  id              String   @id @default(cuid())
  name            String   @unique
  includedMinutes Int
  priceCents      Int
  validityMonths  Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// The set of aircraft this package type may be used on (story 4.3) — see `PackageTypeAircraft` doc.
  eligibleAircraft PackageTypeAircraft[]
  /// Packages sold under this type (story 4.4) — a non-empty set is exactly
  /// what makes this type non-deletable (FK RESTRICT, AC 3); see `HourPackage` doc.
  soldPackages     HourPackage[]
}

/// Explicit join table between `PackageType` and `Aircraft` (story 4.3) — the
/// set of aircraft eligible for a given package type. Modeled explicitly
/// (never an implicit Prisma m-n) per the repo's convention of documented,
/// hand-migrated relations. An aircraft archived AFTER being associated
/// stays in the set (historical listino record, still consultable) — the
/// real usage block on a retired airframe belongs to consumption (epic 5),
/// not to this catalogue.
model PackageTypeAircraft {
  id            String      @id @default(cuid())
  packageTypeId String
  packageType   PackageType @relation(fields: [packageTypeId], references: [id])
  aircraftId    String
  aircraft      Aircraft    @relation(fields: [aircraftId], references: [id])

  @@unique([packageTypeId, aircraftId])
  @@index([aircraftId])
}

/// A sold hour package (epic 4, story 4.4; FR-13). Append-only in spirit
/// (AD-3): there is deliberately no update/delete API here — a wrong sale
/// is out of scope for this story (a coordinated storno across
/// conto+cassa+pacchetto would be an epic 5+ concern, if ever needed).
///
/// **The payment is EXTERNAL to the prepaid account** (contanti/bonifico/
/// POS, exactly like a top-up): the cash register receives `pricePaidCents`
/// (a `CashMovement` under the "Pacchetti" category), but the account
/// BALANCE never changes — buying a package paid in full must never push
/// the account into the red. The twin `AccountMovement` this row links to
/// (`accountMovementId`, type `PACKAGE_PURCHASE`) exists purely so the
/// titolare sees the purchase in their estratto conto: it always carries
/// `amountCents: 0` (the price/method live on `pricePaidCents`/
/// `paymentMethod` here instead — a closed transaction, payment received
/// and package delivered cancel out).
///
/// **No residuo anymore**: consumption against a package was retired by
/// story 12.13 and its per-flight detail table dropped by story 19.6 — this
/// row is a historical record of a sale.
///
/// **Snapshot at sale time** (AD-4, same principle as the historicized
/// rates): `includedMinutes`/`pricePaidCents` are copied from the
/// `PackageType` at the moment of sale and `expiresAt` is materialized
/// (`effectiveDate + validityMonths`, clamped to end-of-month — `null` when
/// the type has no `validityMonths`). A LATER edit to the `PackageType`
/// (story 4.3) never rewrites an already-sold package — this is exactly why
/// the catalogue is allowed to stay mutable. `packageTypeId` is `ON DELETE
/// RESTRICT` (Prisma default for a required relation) — the FK backstop
/// behind `package-types.service.ts#deletePackageType`'s 409 (AC 3).
///
/// The package belongs to the PERSON (`personId`), never a profile (AD-11) —
/// same rationale as `Account`: it survives a student->pilot transition.
model HourPackage {
  id                String          @id @default(cuid())
  personId          String
  person            Person          @relation(fields: [personId], references: [id])
  packageTypeId     String
  packageType       PackageType     @relation(fields: [packageTypeId], references: [id])
  /// Snapshot of `PackageType.includedMinutes` at sale time (AD-2/AD-4).
  includedMinutes   Int
  /// Snapshot of `PackageType.priceCents` at sale time (AD-2/AD-4) — the
  /// amount the cash register received, NOT the account's `amountCents`
  /// (which is always 0 on the linked `AccountMovement`, see model doc).
  pricePaidCents    Int
  /// How the price was paid (reuse of the top-up enum, story 3.1) — external
  /// to the account, mirrored onto the linked `CashMovement` too.
  paymentMethod     PaymentMethod
  /// Value date (data valuta) of the sale — same calendar-only convention as
  /// `AccountMovement.effectiveDate`; the base `expiresAt` is computed from.
  effectiveDate     DateTime        @db.Date
  /// Materialized expiry (AD-4): `effectiveDate + validityMonths`, clamped
  /// to end-of-month (`src/lib/date-only.ts#addMonthsClampUtc`). `null` when
  /// the type had no `validityMonths` at sale time (never expires).
  expiresAt         DateTime?       @db.Date
  /// The `PACKAGE_PURCHASE` twin this package is linked to (traceability,
  /// same pattern as `CashMovement.accountMovementId`) — `@unique`, at most
  /// one package per account movement.
  accountMovementId String          @unique
  accountMovement   AccountMovement @relation(fields: [accountMovementId], references: [id])
  /// The acting `User.id` who recorded the sale — same rationale as every
  /// other ledger's `actorUserId`.
  actorUserId       String
  actorUser         User            @relation(fields: [actorUserId], references: [id])
  createdAt         DateTime        @default(now())

  @@index([personId])
  @@index([packageTypeId])
}

/// A logged flight's purpose (epic 5, story 5.1; renamed to the real-world
/// taxonomy in story 9.4; two values only since story 19.5, which folded the
/// never-used third type into `TOURISM`). `TOURISM` is a tourism/private
/// flight, `SCHOOL` is a training flight WITH an instructor (epic 9 sums
/// school hours per instructor off this). `SCHOOL` mandates an instructor
/// (422 `SCHOOL_FLIGHT_REQUIRES_INSTRUCTOR`); an instructor is also allowed
/// (never required) on `TOURISM` (e.g. a checkride, CR 2026-11-01 A5) and
/// always generates their own charge either way. See `Flight.isSolo` for
/// the dual/solo distinction within `SCHOOL`.
enum FlightType {
  TOURISM
  SCHOOL
}

/// Which of the aircraft rate's two prices a flight was charged (story 19.3,
/// R-19-e): the column of the flying person's PROFILE — an active student
/// profile with no active pilot profile → `STUDENT`, otherwise `PILOT`
/// (a pilot on a `SCHOOL` flight still pays the pilot price). Frozen on the
/// flight next to the price it selected (`Flight.aircraftPriceCategory`).
enum AircraftPriceCategory {
  STUDENT
  PILOT
}

/// A registered flight (epic 5, story 5.1; FR-9/FR-14/FR-15) — the model
/// that, in ONE transaction (`flights.service.ts#registerFlight`), both
/// produces the `FLIGHT_CHARGE` `AccountMovement` (linked via
/// `AccountMovement.flightId`) and records the airframe's hours (an
/// aircraft's total is the sum of its flights' `minutes`, story 19.2 R-19-b). `personId` is who flew/pays (AD-11: always the `Person`, never a
/// profile) — a pilot OR student profile must be active on this person at
/// registration time. `instructorProfileId` is the instructor aboard, when
/// any (the ERD keys it on `InstructorProfile`, while the API accepts a
/// `Person` id and resolves it, consistent with
/// `.../people/{id}/instructor-rates`) — mandatory on `SCHOOL` flights,
/// optional otherwise, and in every case generating its own charge.
///
/// **Snapshot, never recalculated** (AD-4, the same principle as
/// `AircraftRate`/`InstructorRate`/`HourPackage`): `aircraftRateCentsPerHour`/
/// `aircraftAmountCents` (and, when there is an instructor,
/// `instructorRateCentsPerHour`/`instructorAmountCents`) capture the rate in
/// effect at `flightDate` at registration time — a later change to the rate
/// history never rewrites an already-registered flight. Since story 19.3 the
/// aircraft rate has two prices: `aircraftRateCentsPerHour` is the one
/// APPLIED, `aircraftPriceCategory` says which column it came from (the
/// person's profile at registration; a correction that keeps the person
/// keeps the category, Q-19.3-b). There is
/// deliberately NO persisted total: the total lives on the linked
/// `AccountMovement.amountCents` (negative); the UI/DTO computes it from the
/// two per-component amounts (`flights.service.ts#FlightListItem`).
///
/// **`minutes` is always populated** (AD-2) — derived from
/// `takeoffAt`/`landingAt` since story 11.1 (see the logbook fields below).
///
/// **Edited in place, deleted with its charge** (story 19.6, R-19-c — the
/// exception AD-3 makes for the `FLIGHT_CHARGE`): every existing row is a
/// flight that happened. `flights.service.ts#updateFlight` rewrites this row
/// AND its charge (`charge`, same movement id) in one transaction;
/// `deleteFlight` deletes the charge, then this row. There is no lifecycle
/// state, no cancellation and no correction chain anymore.
model Flight {
  id                  String             @id @default(cuid())
  aircraftId          String
  aircraft            Aircraft           @relation(fields: [aircraftId], references: [id])
  personId            String
  person              Person             @relation(fields: [personId], references: [id])
  instructorProfileId String?
  instructorProfile   InstructorProfile? @relation(fields: [instructorProfileId], references: [id])

  /// Calendar-only date of the flight (`@db.Date`) — never in the future
  /// (enforced in the service against the Europe/Rome calendar "today", story 16.1).
  flightDate DateTime   @db.Date
  flightType FlightType
  /// Dual/solo distinction on `SCHOOL` flights (story 9.4) — only
  /// meaningful when `flightType == SCHOOL` (422 `SOLO_REQUIRES_SCHOOL`
  /// otherwise). A solo flight still carries (and bills) the instructor —
  /// the student is PIC; on dual the instructor is PIC. PIC is DERIVED
  /// (solo → student, dual → instructor), not stored — future logbook/QTB
  /// stories will read it from here. `@default(false)`: pre-9.4 history
  /// becomes all-dual, the correct assumption since solos were not
  /// representable before.
  isSolo     Boolean    @default(false)
  /// "Senza addebito" (story 19.6, R-19-d — admin-only, `flights.manage`):
  /// the flight is not charged — both amounts and the `FLIGHT_CHARGE` are 0,
  /// the charge's description starts with "Volo senza addebito" — while the
  /// instructor's compensation still accrues (it reads `minutes`, never the
  /// amounts). The rates are still REQUIRED and frozen on the row as
  /// information (Q-19.6-a = B). The balance check it skips is story 19.9's.
  noCharge   Boolean    @default(false)

  /// Logbook fields (story 11.1, FR-43) — the real departure/arrival
  /// airports and takeoff/landing clock instants a flight actually
  /// happened between. Nullable ONLY for historical flights (pre-11.1):
  /// every NEW registration/correction requires all four
  /// (`resolveFlightInput`, 422 `FLIGHT_TIMES_INVALID` on an invalid
  /// pair) — `minutes`/`flightDate` are DERIVED from `takeoffAt`/
  /// `landingAt`, never independent inputs after this story.
  departureAirfield String?
  arrivalAirfield   String?
  takeoffAt         DateTime?
  landingAt         DateTime?

  minutes  Int
  /// Story 11.1: `takeoffs` mirrors `landings` — both NOT NULL DEFAULT 1
  /// (every flight has at least one of each; historical `landings`
  /// backfilled NULL -> 1, `takeoffs` is a brand-new column so no backfill
  /// is needed).
  takeoffs Int @default(1)
  landings Int @default(1)

  aircraftRateCentsPerHour   Int
  /// The column of the aircraft rate `aircraftRateCentsPerHour` was taken
  /// from (story 19.3, AD-4) — see `AircraftPriceCategory`.
  aircraftPriceCategory      AircraftPriceCategory
  /// Snapshot (AD-4) of the amount ACTUALLY CHARGED for the aircraft
  /// component (story 5.2): pro-rata on `minutes - packageCoveredMinutes`,
  /// never on the full flight duration once a package covered part of it.
  /// `0` on a `noCharge` flight (story 19.6).
  aircraftAmountCents        Int
  instructorRateCentsPerHour Int?
  /// Never reduced by package consumption (AD-6: the instructor is NEVER
  /// covered by a package) — always `round(rate * minutes / 60)` on the
  /// FULL flight duration, `0` (never `null`: the flight still has an
  /// instructor) on a `noCharge` flight (story 19.6).
  instructorAmountCents      Int?
  /// Historical snapshot of the minutes package consumption covered (story
  /// 5.2) — consumption was retired by story 12.13 and its per-package detail
  /// table dropped by story 19.6; `0` on every flight registered since.
  packageCoveredMinutes      Int                   @default(0)

  /// Who recorded this flight (`Actor.userId`, always present) — same
  /// rationale as every other ledger's `actorUserId`.
  actorUserId String
  actorUser   User   @relation(fields: [actorUserId], references: [id])

  /// Admin force-bypass tracking for a blocking expired document at
  /// registration/correction time (story 14.4, AC 2; ratifica R4) — set
  /// TOGETHER, exactly once, ONLY when `resolveFlightInput` actually
  /// bypassed a blocking expired document (`flights.forceExpiry` + `force:
  /// true` + `forceReason`); `null` on every normal flight, INCLUDING a
  /// `force: true` request that had nothing to bypass — same "scavalcato un
  /// blocco, non spuntata una checkbox" convention as `Booking.forcedAt`
  /// (story 7.4).
  forcedAt       DateTime?
  forcedByUserId String?
  forcedByUser   User?     @relation("FlightForcedBy", fields: [forcedByUserId], references: [id])
  forceReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The flight's `FLIGHT_CHARGE` movement (story 19.6, AD-7: one per flight,
  /// `AccountMovement.flightId @unique`) — always present, `0` on a
  /// `noCharge` flight.
  charge        AccountMovement?
  /// Training diary entries that link to THIS flight (epic 9, story 9.2) — see `TrainingNote` doc. Several notes may reference the same flight.
  trainingNotes TrainingNote[]

  @@index([aircraftId])
  @@index([personId])
  @@index([instructorProfileId])
  @@index([flightDate])
}

/// Aircraft booking (epic 7, story 7.1; FR-18) — reserves a `[startsAt,
/// endsAt)` interval on an `Aircraft` for a `Person`. Deliberately mirrors
/// `Flight`'s shape (Contesto): `personId` is the person the aircraft is
/// booked FOR (a pilot booking for themself, or an allievo in a school
/// booking) — never the actor who created the row, tracked separately via
/// `actorUserId` (same split as `Flight`). `instructorProfileId` is the
/// instructor indicated on a school booking, `null` for a plain pilot
/// booking — same optional-FK shape as `Flight.instructorProfileId`.
///
/// `[startsAt, endsAt)` is a SEMI-OPEN interval (Contesto): two bookings on
/// the same aircraft where one ends exactly when the other starts are NOT
/// overlapping — `startsAt`/`endsAt` are full instants (`DateTime`
/// timestamptz), the first datetime fields in this codebase (wire format
/// ISO 8601 UTC, AD-8). The overlap invariant has THREE subjects since
/// story 16.3 (ops F2): the aircraft, the person (`personId`) and the
/// instructor (`instructorProfileId`) — none of them may hold two APPROVED
/// bookings over overlapping intervals (409 `CONFLICT` / `PERSON_BUSY` /
/// `INSTRUCTOR_BUSY`, `bookings.service.ts#findBookingConflict`). The
/// concurrency guard is a row lock per subject inside `prisma.$transaction`,
/// in one global order on every write path — the `Booking` row being written
/// `FOR UPDATE` (a move or a transition; review 16.3 MAJOR-2) → `Aircraft`
/// `FOR UPDATE` (the
/// exact pattern of `flights.service.ts#registerFlight`; story 7.3 locks N of
/// them `ORDER BY id` for a MOVE) → `Person` → `InstructorProfile`, the last
/// two `FOR NO KEY UPDATE` so that no foreign-key check elsewhere ever waits
/// on them (`bookings.service.ts#lockBookingPeople`) — which makes the
/// pre-check-overlap + write airtight.
/// Deliberately NOT a Postgres exclusion constraint (`btree_gist`), a choice
/// first made with one subject and RE-EVALUATED with three in story 16.3:
/// it would take three partial constraints on `status = 'APPROVED'` (raw
/// migration + extension) that the load DB already violates (18 person + 11
/// instructor pairs measured), its `23P01` would have to be told apart by
/// constraint NAME to pick the 409 code, and it would not remove the
/// `Aircraft` lock, which also guards the aircraft's STATE read. If the DB is
/// ever to become the arbiter, this is where to reopen the question.
///
/// **Soft-cancel, never delete** (story 7.3): cancelling flips `status` to `CANCELLED`
/// (`cancelledAt`/`cancelledByUserId` set together, `updateBooking`/
/// `cancelBooking` in `bookings.service.ts`) and FREES the slot — every
/// overlap predicate (create/edit/approve) filters `status: 'APPROVED'`
/// (story 12.2: only an APPROVED booking occupies a slot, see below), so a
/// cancelled booking disappears from every list/calendar while the row
/// itself stays forever (the audit trail). `updatedByUserId` tracks the
/// actor of the LAST edit (AC 2 "chi, quando"; `updatedAt` is automatic) —
/// `actorUserId` stays the CREATOR forever, never reassigned by an edit.
///
/// **Approval workflow (epic 12, story 12.2)**: `status` starts `PENDING`
/// when created by a `bookings.manage.own` actor (pilot/instructor booking
/// for themself or an allievo) and `APPROVED` when created by
/// `bookings.manage.any` (staff) — `bookings.service.ts#createBooking`
/// always stamps it explicitly, this field's own `@default` is schema
/// coherence only. `bookings.service.ts#transitionBooking` (staff-only,
/// `bookings.manage.any`) moves it through the rest of the matrix: `PENDING
/// -> APPROVED` (re-runs the create-time expiry/overlap/aircraft-state
/// checks, stamps `decidedAt`/`decidedByUserId`) or `PENDING -> DENIED`
/// (`denyReason` mandatory, stamps `decidedAt`/`decidedByUserId`, fires a
/// best-effort email to the booking-holder); `APPROVED -> FLOWN | NO_SHOW`
/// (stamps `closedAt`/`closedByUserId`); any of `DENIED`/`FLOWN`/`NO_SHOW`
/// back to `PENDING` ("riapri") clears every decision/closure field. ONLY
/// `APPROVED` occupies a slot for the overlap invariant — two `PENDING`
/// bookings may legitimately coexist on the same aircraft/interval, the
/// conflict surfacing only when one of them is approved.
///
/// **Expiry-based creation block (epic 7, story 7.4; FR-21)**: `createBooking`
/// blocks a NEW booking (422 `EXPIRED_DOCUMENTS`) when the TARGET person
/// (`personId`) has a registered `Expiry` past its `expiresAt` on the
/// FLIGHT DAY (`startsAt`'s date in `APP_TIMEZONE`, not "today") whose
/// `ExpiryType.blocksBooking` is `true`; a non-blocking expired document is
/// only a `warnings` entry in the creation response, never persisted here.
/// Staff (`bookings.manage.any`) may bypass a real block with `force` +
/// `forceReason`, stamping `forcedAt`/`forcedByUserId`/`forceReason` — see
/// those fields' own doc-comments and `bookings.service.ts#createBooking`.
model Booking {
  id                  String             @id @default(cuid())
  aircraftId          String
  aircraft            Aircraft           @relation(fields: [aircraftId], references: [id])
  personId            String
  person              Person             @relation(fields: [personId], references: [id])
  instructorProfileId String?
  instructorProfile   InstructorProfile? @relation(fields: [instructorProfileId], references: [id])

  startsAt DateTime
  endsAt   DateTime
  notes    String?

  status            BookingStatus @default(PENDING)
  /// Set together with `cancelledByUserId`, exactly once, when this booking
  /// transitions to `CANCELLED` (story 7.3) — `null` while `ACTIVE`.
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledByUser   User?         @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id])
  /// The actor of the most recent `updateBooking` (story 7.3, AC 2) —
  /// `null` until the first edit. Distinct from `actorUserId` (the
  /// creator, immutable forever).
  updatedByUserId   String?
  updatedByUser     User?         @relation("BookingUpdatedBy", fields: [updatedByUserId], references: [id])

  /// Staff force-bypass tracking (epic 7, story 7.4, AC 2) — set TOGETHER,
  /// exactly once, ONLY when `createBooking` actually bypassed a blocking
  /// expired document (`bookings.manage.any` + `force: true` +
  /// `forceReason`); `null` on every normal booking, INCLUDING a
  /// `force: true` request that had nothing to bypass (Contesto: the
  /// tracking says "scavalcato un blocco", not "spuntato una checkbox").
  /// Never touched by `updateBooking`/`cancelBooking` — the force decision
  /// is a creation-time fact, not re-evaluated on edit (see `createBooking`'s
  /// doc-comment for the deferred re-check rationale).
  forcedAt       DateTime?
  forcedByUserId String?
  forcedByUser   User?     @relation("BookingForcedBy", fields: [forcedByUserId], references: [id])
  forceReason    String?

  /// Approval-workflow decision tracking (story 12.2, AC 3): set TOGETHER
  /// on `PENDING -> APPROVED` and `PENDING -> DENIED`; ALL reset to `null`
  /// (alongside `closedAt`/`closedByUserId`) on a "riapri" back to
  /// `PENDING`. `denyReason` is additionally non-null only after a DENIED
  /// decision (mandatory input on that transition).
  decidedAt       DateTime?
  decidedByUserId String?
  decidedByUser   User?     @relation("BookingDecidedBy", fields: [decidedByUserId], references: [id])
  denyReason      String?
  /// Closure tracking (story 12.2, AC 3): set TOGETHER on `APPROVED ->
  /// FLOWN | NO_SHOW`; reset to `null` on a "riapri" back to `PENDING`.
  closedAt        DateTime?
  closedByUserId  String?
  closedByUser    User?     @relation("BookingClosedBy", fields: [closedByUserId], references: [id])

  /// Who created this booking (`Actor.userId`, always present) — same
  /// rationale as every other ledger's `actorUserId` (e.g. `Flight`).
  /// Named (not the implicit default) because `User` now holds THREE
  /// distinct relations to `Booking` (created/updated/cancelled).
  actorUserId String
  actorUser   User   @relation("BookingActor", fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Backs both the AIRCRAFT overlap scan (`aircraftId` + range on
  /// `startsAt`) and the calendar view (story 7.2). The PERSON and
  /// INSTRUCTOR overlap scans (story 16.3) are served by the two plain
  /// indexes below — measured on the 40 000-booking load DB: a bitmap index
  /// scan on `Booking_personId_idx`, 0.17 ms, at most 25 bookings per person
  /// and 31 per instructor — so neither needed a composite index. No
  /// separate `@@index([status])`: every query already filters on
  /// `aircraftId`/`startsAt`, `personId` or `instructorProfileId`, or scans
  /// the whole (small) active set — `status` alone would not narrow any
  /// access path enough to earn its own index (doc-comment per story 7.3's
  /// Task 1, deliberately omitted).
  @@index([aircraftId, startsAt])
  @@index([personId])
  @@index([instructorProfileId])
}

/// A booking's lifecycle state (story 7.3; extended by the approval
/// workflow, story 12.2) — see `Booking`'s doc-comment for the full
/// transition matrix (`bookings.service.ts#transitionBooking`). `PENDING`
/// is the starting state for a `bookings.manage.own` actor's own booking;
/// `APPROVED` is both staff's own starting state AND the outcome of an
/// approval — it is the ONLY state that occupies a slot for the overlap
/// invariant. `DENIED`/`FLOWN`/`NO_SHOW` are terminal unless reopened
/// ("riapri") back to `PENDING`. `CANCELLED` (story 7.3, soft-delete) frees
/// the slot and is reachable from `PENDING`/`APPROVED` via `cancelBooking`
/// only — never part of `transitionBooking`'s own matrix.
enum BookingStatus {
  PENDING
  APPROVED
  DENIED
  FLOWN
  NO_SHOW
  CANCELLED
}

/// Expiry-type "ambito" (epic 6, story 6.1; FR-35) — who a given expiry type
/// is meant for. `ALL` matches any person; every other value matches a
/// person with the corresponding profile currently active. The
/// scope↔person compatibility CHECK is deliberately NOT implemented here —
/// it belongs to `Expiry` registration (story 6.2, its own AC); here scope
/// is only an attribute shown/managed on the catalogue entry.
///
/// Story 19.7a (R-19-j, D-3): a scope is meaningful for a RATING only. A
/// MEDICAL type is ALWAYS `ALL` (any valid visit of any class covers whoever
/// is on board) and the MEMBERSHIP type is `ALL` too — an invariant kept by
/// the migration and by `expiry-types.service.ts`, never a nullable column.
enum ExpiryScope {
  PILOTS
  STUDENTS
  INSTRUCTORS
  ALL
}

/// What an expiry type IS (story 13.1, R-13.1-a) — a SEPARATE axis from
/// `ExpiryScope` (who it's for). Three values since story 19.7a:
/// - `RATING`: an abilitazione; blocks bookings/flights only when its own
///   `blocksBooking` says so, per type and per applicable scope.
/// - `MEDICAL`: a medical visit. No scope and no per-type blocking (R-19-j,
///   D-3/D-4): whoever is on board needs ONE valid visit of ANY class, as
///   long as at least one MEDICAL type is active
///   (`src/lib/medical-requirement.ts`).
/// - `MEMBERSHIP`: the "Quota associativa" (R-19-k, D-1) — a SYSTEM type,
///   exactly one row, upserted by name by `membership.service.ts`; no API
///   creates, edits or deletes it (`expiry-types.service.ts`), and it never
///   enters a per-type blocking scan.
/// A registered `Expiry` is the same row whatever the kind.
enum ExpiryTypeKind {
  RATING
  MEDICAL
  MEMBERSHIP
}

/// Expiry-type catalogue (epic 6, story 6.1; FR-35). MUTABLE catalogue
/// configuration — like `CashCategory` (story 3.4) / `PackageType` (story
/// 4.3) — NOT an append-only ledger: created, edited and
/// activated/deactivated freely, and deleted ONLY while never referenced by
/// a recorded `Expiry`. Today (story 6.1) no FK points at this table yet;
/// story 6.2 adds `Expiry.expiryTypeId` with `ON DELETE RESTRICT`, and
/// `expiry-types.service.ts#deleteExpiryType`'s `P2003` catch is already
/// the 409 backstop for that constraint (same split already validated for
/// `PackageType` → `HourPackage`, story 4.3 → 4.4).
///
/// Deliberately NO `isSystem` flag: the standard types seeded here (visita
/// medica classe 1/2/LAPL, rating SEP, inglese ICAO) are plain rows — the
/// admin can rename them, deactivate them and (while still unused) delete
/// them exactly like a custom type (a medical visit keeps `scope = ALL`,
/// story 19.7a D-3). The one exception is the `MEMBERSHIP` kind (see
/// `ExpiryTypeKind`), recognised by its kind, not by a flag. "Licenza" is no
/// longer an expiry type (story 19.7a, R-19-k): the licence stays the
/// informative `PilotProfile.licenseType`. The seed is idempotent
/// (`update: {}`), so a re-seed never overwrites an admin's customization.
///
/// Editing a type already IN USE is legal: a registered `Expiry` (story
/// 6.2) references this row by id and never snapshots the name, so a
/// rename/re-scope is never a retroactive rewrite of history — a scope
/// change only affects FUTURE registration-time compatibility checks
/// (story 6.2), never past ones.
model ExpiryType {
  id             String         @id @default(cuid())
  name           String         @unique
  scope          ExpiryScope
  /// RATING / MEDICAL / MEMBERSHIP (story 13.1, R-13.1-a; story 19.7a).
  /// Defaults `RATING` — every existing type keeps behaving as an
  /// abilitazione unless the migration's data-backfill (or an admin, going
  /// forward, via the dedicated card) marks it MEDICAL.
  kind           ExpiryTypeKind @default(RATING)
  isActive       Boolean        @default(true)
  /// Read for `kind = RATING` ONLY (story 19.7a, AD-3): a MEDICAL type always
  /// carries `true` (invariant, D-3) but the medical requirement is the
  /// "one valid visit of any class" rule, never a per-type scan; the
  /// MEMBERSHIP type carries `false` and never blocks per type.
  ///
  /// Whether an EXPIRED `Expiry` of this type blocks a NEW booking (epic 7,
  /// story 7.4; FR-21 `[ASSUMPTION]`) AND a NEW flight registration/edit
  /// (epic 14, story 14.4, AC 1; ratifica R4) — the SAME flag gates both, deliberately not
  /// renamed/split (story 14.4's own AC 1 left the rename optional; the
  /// field's semantics — "an expired document of this type blocks the
  /// operation" — already generalize without one). Default `false` (a
  /// new/custom type never blocks until an admin opts it in, `settings.manage`,
  /// `types-manager.tsx`'s checkbox) — the migration backfills `true` on the
  /// 4 standard blocking types by exact seed name
  /// (`prisma/migrations/20260709120000_add_booking_expiry_block`). Consumed
  /// by `bookings.service.ts#findBlockingExpiredDocuments` — shared by
  /// `createBooking`/`updateBooking` (bookings) and, since story 14.4,
  /// `flights.service.ts#resolveFlightInput` (flights) — see those
  /// functions' doc-comments for the flight-day comparison and force/warning
  /// semantics.
  blocksBooking  Boolean        @default(false)
  /// Validity window in months, used to PRECOMPILE `Expiry.expiresAt` at
  /// registration time (story 12.11, ratifica utente 2) — `null`/`0` means
  /// "no expiry" (badge shown in the catalogue UI). ADDITIVE: existing rows
  /// read `null` (no backfill, no retroactive recalculation of already
  /// registered `Expiry` rows) until an admin sets it from Impostazioni.
  validityMonths Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// Scadenze registered against this type (epic 6, story 6.2) — a non-empty
  /// set is exactly what makes this type non-deletable (FK RESTRICT, story
  /// 6.1 AC 2 completed here); see `Expiry` doc.
  expiries Expiry[]
}

/// Proposal lifecycle state for `ExpiryUpdateProposal` (epic 6, story 6.2, AC 2).
enum ExpiryProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The CURRENT abilitative scadenza for a (persona, tipo) pair (epic 6,
/// story 6.2; FR-36). ONE row per `(personId, expiryTypeId)` —
/// `@@unique` below — because this domain tracks the current
/// abilitative STATE, not a renewal history: a renewal (e.g. a new visita
/// medica) is an UPDATE of this same row, never a new row. The history of
/// APPROVED renewals stays consultable via `ExpiryUpdateProposal` (see that
/// model's doc) — nothing here is append-only.
///
/// **Status is NEVER persisted** (no `status` column): `ok` / `expiring` /
/// `expired` is always DERIVED from `expiresAt` vs "today" via the shared,
/// pure `src/lib/expiry-status.ts#computeExpiryStatus` helper (usable from
/// server AND client, story 6.3's alert job and 6.4's dashboard reuse the
/// exact same function) — `expired` iff `expiresAt < today` (the expiry day
/// itself is still valid, the same boundary convention as
/// `HourPackage.expiresAt` vs `flightDate`).
///
/// `expiresAt` is calendar-only (`@db.Date`, same convention as
/// `AccountMovement.effectiveDate`) — bound ONLY via `date-only.ts`'s
/// `parseDateOnlyUtc`/`todayDateOnlyUtc` helpers, never a raw
/// `new Date(string)` (review 3.5 F1's lesson). There used to be an
/// `issuedAt` alongside it (story 6.2); story 13.1's review (R6, PO
/// ratifica 2026-07-23) dropped it — it carried no domain meaning (status
/// derives from `expiresAt` alone) and its only effect was a cross-field
/// guard the one-step composite create forgot to apply (review F1).
///
/// `expiryTypeId`'s FK is EXPLICIT `onDelete: Restrict` (this already
/// matches the Prisma default for a required relation — spelled out here to
/// honor `ExpiryType`'s doc-comment promise, story 6.1 -> 6.2): a scadenza
/// referencing a type makes that type non-deletable, backed by
/// `expiry-types.service.ts#deleteExpiryType`'s pre-check + `P2003` backstop
/// (409, "in use — deactivate it instead").
model Expiry {
  id           String     @id @default(cuid())
  personId     String
  person       Person     @relation(fields: [personId], references: [id])
  expiryTypeId String
  expiryType   ExpiryType @relation(fields: [expiryTypeId], references: [id], onDelete: Restrict)
  expiresAt    DateTime   @db.Date
  notes        String?
  /// Who registered/last updated this scadenza (`Actor.userId`, always
  /// present) — same rationale as every other ledger's `actorUserId`.
  actorUserId  String
  actorUser    User       @relation(fields: [actorUserId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Update proposals filed by this scadenza's titolare (epic 6, story 6.2,
  /// AC 2) — see `ExpiryUpdateProposal` doc. Cascades on delete (that
  /// model's `expiryId` FK) — deleting a scadenza (a staff correction tool,
  /// e.g. wrong type/person) drops its proposals too, pending included.
  proposals  ExpiryUpdateProposal[]
  /// Alert-threshold idempotence ledger (epic 6, story 6.3, AD-9) — see
  /// `SentAlert` doc. Cascades on delete, same rationale as `proposals`.
  /// Wiped (NOT cascaded-delete — a `deleteMany`) whenever `expiresAt`
  /// actually changes value, in `expiries.service.ts#updateExpiry` and the
  /// APPROVE branch of `decideExpiryProposal` — a renewal must re-earn its
  /// alert cycle.
  sentAlerts SentAlert[]

  @@unique([personId, expiryTypeId])
  @@index([expiryTypeId])
  @@index([expiresAt])
}

/// Idempotence ledger for the automatic expiry-alert job (epic 6, story 6.3,
/// AD-9; FR-37) — `expiry-alerts.service.ts#runExpiryAlertsJob`. One row per
/// `(Expiry, threshold)` EVER consumed; `@@unique` below is the DB-level
/// guarantee a threshold is alerted AT MOST ONCE, the actual idempotence
/// contract (AC 2) — the job's own pre-check is only an optimization, this
/// row is what a concurrent/duplicate run's `P2002` backstops against.
///
/// "Threshold consumed" is not the same as "an email was sent about exactly
/// that threshold": when a run finds MULTIPLE due-but-unconsumed thresholds
/// for the same scadenza (a skipped cron, or a scadenza registered already
/// close to/past its date), it sends ONE holder email — about the real
/// `daysLeft`, never the threshold — and inserts a `SentAlert` row for EVERY
/// threshold it just caught up on, in the SAME transaction, BEFORE sending
/// that email (insert-before-send: a crash in between loses that one email,
/// deliberately accepted — AD-9 privileges "never more than one alert per
/// threshold" over "never lose one", and the staff digest is the recovery
/// net).
///
/// `expiryId`'s FK is `onDelete: Cascade` (announced by story 6.2's `Expiry`
/// doc-comment): deleting a scadenza (a staff correction tool) drops its
/// alert history too — nothing meaningful survives without the scadenza it
/// alerted about.
model SentAlert {
  id        String   @id @default(cuid())
  expiryId  String
  expiry    Expiry   @relation(fields: [expiryId], references: [id], onDelete: Cascade)
  /// The alert threshold consumed, in days (`EXPIRY_ALERT_THRESHOLDS` =
  /// `[60, 30, 7, 0]`, `src/lib/expiry-status.ts`) — a marker of cadence
  /// consumed, not a claim that the email literally mentioned this number.
  threshold Int
  sentAt    DateTime @default(now())

  @@unique([expiryId, threshold])
}

/// A titolare-filed proposal to update their OWN `Expiry` (epic 6, story
/// 6.2, AC 2; FR-36) — the value on `Expiry` stays authoritative until staff
/// approves it (the own-vs-manage split, AD-5: `expiries.propose.own` files
/// this, only `expiries.manage` decides it — never the reverse). Approving
/// applies `proposedIssuedAt`/`proposedExpiresAt`/`proposedNotes` onto the
/// target `Expiry` inside the SAME transaction as the decision
/// (`expiries.service.ts#decideExpiryProposal`); rejecting leaves the
/// `Expiry` untouched. This table itself is the append-only record of every
/// proposal ever filed (PENDING/APPROVED/REJECTED all stay, never deleted —
/// except cascading away with their `Expiry`, see that model's doc).
///
/// **At most one PENDING proposal per `Expiry`** — enforced by a
/// HAND-APPENDED partial unique index
/// (`ExpiryUpdateProposal_expiryId_pending_key` — see the migration SQL,
/// the Prisma DSL cannot express a partial/filtered unique index),
/// backstopped by a `P2002` catch in
/// `expiries.service.ts#proposeExpiryUpdate` (pre-check + backstop, the same
/// shape as every other unique constraint in this codebase). A future
/// `prisma migrate diff` against this schema will report drift for that one
/// index — accepted, the same tradeoff already made for any hand-appended
/// SQL the Prisma DSL cannot express.
///
/// `expiryId`'s FK is `onDelete: Cascade` — the first cascading FK in this
/// domain, deliberate: a proposal has no standalone meaning once its target
/// scadenza is gone (see `Expiry.proposals` doc).
///
/// Two independent FKs to `User` (`proposedByUserId`/`decidedByUserId`) —
/// the first case in this codebase where more than one relation targets the
/// same model, which Prisma requires disambiguating with an explicit
/// `@relation("name")` on BOTH sides (`ExpiryProposalProposedBy`/
/// `ExpiryProposalDecidedBy`, see the matching `User.expiryProposalsFiled`/
/// `expiryProposalsDecided` back-relations).
///
/// `decidedByUserId`/`decidedAt` are set TOGETHER, exactly once, by
/// `decideExpiryProposal` (APPROVE or REJECT) — both `null` while PENDING,
/// same "set together exactly once" convention as
/// `Booking.cancelledAt`/`cancelledByUserId`.
model ExpiryUpdateProposal {
  id                String               @id @default(cuid())
  expiryId          String
  expiry            Expiry               @relation(fields: [expiryId], references: [id], onDelete: Cascade)
  proposedIssuedAt  DateTime             @db.Date
  proposedExpiresAt DateTime             @db.Date
  proposedNotes     String?
  status            ExpiryProposalStatus @default(PENDING)
  proposedByUserId  String
  proposedByUser    User                 @relation("ExpiryProposalProposedBy", fields: [proposedByUserId], references: [id])
  decidedByUserId   String?
  decidedByUser     User?                @relation("ExpiryProposalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([expiryId])
  @@index([status])
}

/// Story TD-2 (closes the 3.1 review deferral O2, evaluated epic-wide as
/// promised): backs the opt-in `Idempotency-Key` header on the 5
/// money-mutating POSTs (top-up, rettifica, vendita pacchetto, registrazione
/// volo, movimento cassa manuale — `src/lib/api/handler.ts`'s `idempotency`
/// option on `apiRoute`). A network retry that repeats the same header
/// replays the FIRST response instead of re-executing the mutation.
///
/// PER-USER: `@@unique([userId, endpoint, key])` — the same key value from
/// two DIFFERENT users never collides (no cross-user replay/DoS; a
/// malicious/careless client cannot make its key deterministic and thereby
/// probe or block another user's request).
///
/// `responseStatus`/`responseBody` are BOTH `null` while the request is
/// PENDING (the row is inserted before `handle` runs) — a concurrent second
/// attempt with the same key hitting the still-PENDING row gets 409
/// `IDEMPOTENCY_IN_PROGRESS`, never a stale/partial replay. Both fields (plus
/// `completedAt`) are set TOGETHER, exactly once, immediately after `handle`
/// succeeds — same "set together exactly once" convention as
/// `Booking.cancelledAt`/`cancelledByUserId`. A request that FAILS (any `DomainError`
/// or unknown error) DELETES its row instead, so the key is immediately
/// reusable (AC 4) — the user corrects the input and retries with the same
/// key without ever being stuck.
///
/// **Crash window (documented trade-off, same shape as AD-9's `SentAlert`
/// insert-before-send)**: a process crash between the mutation's COMMIT and
/// this row's completion update leaves an orphaned PENDING row — every
/// future retry with that exact key gets 409 forever. Accepted: the client
/// resolves by using a NEW key after manually verifying whether the original
/// mutation went through. NO auto-expiry job in this story (deliberate:
/// auto-expiring a PENDING row risks letting a second attempt execute the
/// mutation twice, which is exactly what this table exists to prevent —
/// strictly worse than a permanently-stuck key). NO cleanup job either
/// (deliberate: only 5 endpoints are covered, one row per IN-FLIGHT or
/// FAILED-to-complete attempt at most survives — completed/replayed rows do
/// accumulate slowly, but the table stays small; revisit if that ever
/// changes).
///
/// `userId`'s FK is the DEFAULT (`RESTRICT`, same as every other required
/// `User` FK in this schema, e.g. `AccountMovement.actorUserId`) — a `User`
/// with idempotency history cannot be hard-deleted (there is no hard-delete
/// path for `User` in this codebase anyway, only deactivation).
///
/// `requestFingerprint` (security audit 2026-07-22, finding M1): sha256 of
/// `method + endpoint + canonical(params) + canonical(body)`, stamped on the
/// PENDING row at creation. A P2002 conflict whose stored fingerprint
/// differs from the incoming request's is a DIFFERENT operation reusing the
/// same key — `apiRoute` answers `422 IDEMPOTENCY_KEY_MISMATCH` instead of
/// replaying the first operation's response over it. Nullable/backfill-safe:
/// a row with no stored fingerprint (pre-migration) is never treated as a
/// mismatch, only as "unverifiable" — it still replays, same as before this
/// column existed.
model IdempotencyRecord {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  endpoint           String
  key                String
  requestFingerprint String?
  responseStatus     Int?
  responseBody       Json?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  @@unique([userId, endpoint, key])
}
