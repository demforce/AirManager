{
  "name": "airmanager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.11",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=dot --silent=passed-only",
    "test:e2e": "playwright test",
    "gates": "bash scripts/gates.sh",
    "db:reset": "bash scripts/reset-db.sh",
    "db:reset:test": "node scripts/reset-test-db.mjs",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:load": "tsx prisma/seed-load.ts",
    "postinstall": "prisma generate",
    "mail:worker": "tsx scripts/mail-worker.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "5.4.0",
    "@noble/hashes": "1.8.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "exceljs": "^4.4.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "4.13.1",
    "nodemailer": "9.0.3",
    "pdfkit": "0.20.2",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.12",
    "@playwright/test": "1.61.1",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@hono/node-server": "^1.19.13"
  }
}
