# Copy to .env and adjust if needed. Values below match docker-compose.yml.

# PostgreSQL connection string (docker compose service `postgres`)
DATABASE_URL="postgresql://airmanager:airmanager@localhost:5432/airmanager?schema=public"

# Max size of the Postgres connection pool (pg adapter), per Node process.
# Optional — defaults to 10 (pg's own implicit default) when unset. Raising
# it trades P2028 "Unable to start a transaction" errors under contention
# for more open connections; keep DATABASE_POOL_MAX x instances <=
# max_connections (100 by default). See src/server/db/prisma.ts.
DATABASE_POOL_MAX="10"

# Node environment: development | test | production
NODE_ENV="development"

# Auth.js v5 — signs/encrypts the JWT session cookie. Generate a real value
# with `npx auth secret` (or any 32+ byte random string) for every environment.
# MUST be replaced in production: this exact placeholder is rejected at boot
# when NODE_ENV=production (a public, known secret would let anyone forge a
# session).
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Password for the demo admin user (admin@airmanager.local) created by
# `prisma/seed.ts` / `prisma/seed-demo.ts`. Dev/test only — optional (both
# seed scripts refuse to run when NODE_ENV=production), never reuse in
# production.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Base URL used to build absolute links in invite/password-reset emails.
APP_URL="http://localhost:3000"

# SMTP transport for MailSender (story 1.4) — Mailpit in dev/test (SMTP on
# 1025, web UI/API on 8025). Point at a real provider in production.
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="AirManager <no-reply@airmanager.local>"

# Bearer token the EXTERNAL cron presents to POST /api/v1/jobs/* (story 6.3,
# AD-9) — never a user session. Generate a real random value per environment
# (e.g. `openssl rand -hex 32`); this route answers 500 if unset. MUST be
# replaced in production: this exact placeholder is rejected at boot when
# NODE_ENV=production.
JOBS_SECRET="dev-jobs-secret-change-me"
