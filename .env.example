# Copy to .env and adjust if needed. Values below match docker-compose.yml.

# PostgreSQL connection string (docker compose service `postgres`)
DATABASE_URL="postgresql://airmanager:airmanager@localhost:5432/airmanager?schema=public"

# Node environment: development | test | production
NODE_ENV="development"

# Auth.js v5 — signs/encrypts the JWT session cookie. Generate a real value
# with `npx auth secret` (or any 32+ byte random string) for every environment.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Password for the demo admin user (admin@airmanager.local) created by
# `prisma/seed.ts`. Dev/test only — never reuse in production.
SEED_ADMIN_PASSWORD="ChangeMe123!"
